  "cards": [
    {
      "dot": "cyan",
      "title": "Manual entrypoint",
      "items": [
        "Invoke $update-human-host in this workspace. The runbook owns commands and recovery.",
        "Capture hands off to the wiki precheck. Unknown source or identity inputs stop before costly reader and release work."
      ]
    },
    {
      "dot": "rose",
      "title": "Source and review boundaries",
      "items": [
        "Repair the owning rules, then repeat wiki.py precheck. Clean results feed the normal update through existing caches.",
        "Expanded Hordes uses its separate public repository. A necessary develop PR waits for user review."
      ]
    },
    {
      "dot": "emerald",
      "title": "Publication and recovery",
      "items": [
        "The local update never publishes sites. Reviewed main, exact-commit CI and fresh rehearsal precede publication.",
        "Capture failures preserve the previous snapshot. Failed publication attempts are abandoned before fresh rehearsal."
      ]
    }
  ]
