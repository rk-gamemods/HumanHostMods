  "cards": [
    {
      "dot": "cyan",
      "title": "Source boundary",
      "items": [
        "The capture repository has no remote. The wiki reads it in place and publishes selected derived facts.",
        "Input receipts, identity history, local releases and publication receipts have separate identities."
      ]
    },
    {
      "dot": "rose",
      "title": "Lineage review",
      "items": [
        "A missing source object, an unsupported capture and an unresolved surviving object are different states.",
        "Source and identity gaps stop before reader work. Repair owning rules and use the cached precheck before the full update."
      ]
    },
    {
      "dot": "emerald",
      "title": "Proof limits",
      "items": [
        "Stage checks establish pinned inputs, output hashes and reference integrity.",
        "Publication verifies released bytes. Gameplay verification still requires separate evidence."
      ]
    }
  ]
